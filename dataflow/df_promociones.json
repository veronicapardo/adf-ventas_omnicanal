{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_inicio = iif(isNull(fecha_inicio) || trim(toString(fecha_inicio)) == '' || toString(fecha_inicio) == 'NULL', toDate(null()), toDate(fecha_inicio, 'yyyy-MM-dd')),",
				"          fecha_fin = iif(\r",
				"    isNull(fecha_fin) || trim(toString(fecha_fin)) == '' || toString(fecha_fin) == 'NULL',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        toDate(fecha_fin, 'yyyy-MM-dd') < toDate(fecha_inicio, 'yyyy-MM-dd'),\r",
				"        toDate(fecha_inicio, 'yyyy-MM-dd'),\r",
				"        toDate(fecha_fin, 'yyyy-MM-dd')\r",
				"    )\r",
				"),",
				"          porcentaje_descuento = iif(isNull(porcentaje_descuento) || trim(toString(porcentaje_descuento)) == '' || toString(porcentaje_descuento) == 'NULL' || toInteger(porcentaje_descuento) > 100 || toInteger(porcentaje_descuento) < 0, toInteger(null()), toInteger(porcentaje_descuento)),",
				"          canal_aplicable = iif(isNull(canal_aplicable) || toString(canal_aplicable) == 'NULL' || trim(toString(canal_aplicable)) == '', toString(null()), initCap(lower(trim(toString(canal_aplicable)))))) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(promocion_id),",
				"     nombre_promocion = first(nombre_promocion),",
				"          fecha_inicio = first(fecha_inicio),",
				"          fecha_fin = first(fecha_fin),",
				"          porcentaje_descuento = first(porcentaje_descuento),",
				"          canal_aplicable = first(canal_aplicable)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as integer,",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion = promocion_id,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}