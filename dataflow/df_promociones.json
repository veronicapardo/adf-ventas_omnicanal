{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_inicio = iif(isNull(fecha_inicio) || trim(toString(fecha_inicio)) == '', toDate(null()), toDate(fecha_inicio, 'yyyy-MM-dd')),",
				"          fecha_fin = iif(isNull(fecha_fin) || trim(toString(fecha_fin)) == '', toDate(null()), toDate(fecha_fin, 'yyyy-MM-dd')),",
				"          porcentaje_descuento = iif(isNull(porcentaje_descuento) || trim(toString(porcentaje_descuento)) == '' || toString(porcentaje_descuento) == 'NULL', toDecimal(null()), toDecimal(porcentaje_descuento, 5, 2))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as integer,",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}