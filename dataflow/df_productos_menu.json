{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_producto = initCap(lower(trim(nombre_producto))),",
				"          categoria = iif(isNull(categoria) || toString(categoria) == 'NULL' || trim(toString(categoria)) == '', 'General', initCap(lower(trim(toString(categoria))))),",
				"          disponible = initCap(lower(trim(disponible))),",
				"          precio_texto = iif(isNull(precio_lista) || toString(precio_lista) == '', toDecimal(0.0, 10, 2), toDecimal(precio_lista, 10, 2)),",
				"          costo_estimado = iif(\r",
				"    isNull(costo_estimado) || toString(costo_estimado) == 'NULL' || trim(toString(costo_estimado)) == '',\r",
				"    toDecimal(null()),\r",
				"    toDecimal(regexReplace(toString(costo_estimado), '[^0-9\\\\.-]', ''), 10, 2)\r",
				"),",
				"          producto_id = trim(toString(producto_id))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id) && !isNull(precio_lista) && !isNull(costo_estimado),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista,",
				"          costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}