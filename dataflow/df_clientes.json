{
	"name": "df_clientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = ERROR_FUNCTION('')) ~> derivedColumn1"
			]
		}
	}
}