{
	"name": "df_clientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "clientes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = initCap(lower(trim(nombre))),",
				"          ciudad = case(\r",
				"    upper(trim(ciudad)) == 'SCZ', 'Santa Cruz de la Sierra',\r",
				"    upper(trim(ciudad)) == 'CBBA', 'Cochabamba',\r",
				"    upper(trim(ciudad)) == 'LPZ', 'La Paz',\r",
				"    initCap(lower(trim(ciudad)))\r",
				"),",
				"          email =     iif(\r",
				"        endsWith(trim(email), '@'), \r",
				"        concat(trim(email), 'correo.bo'), \r",
				"        lower(trim(email))\r",
				"    )\r",
				") ~> derivedColumn1",
				"derivedColumn1 split(!isNull(cliente_id) && !isNull(nombre) && !isNull(ciudad) && !isNull(email) && email !='',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(cliente_id),",
				"     nombre = first(nombre),",
				"          email = first(email),",
				"          telefono = first(telefono),",
				"          ciudad = first(ciudad),",
				"          fecha_registro = first(fecha_registro),",
				"          segmento = first(segmento)) ~> aggregate1",
				"aggregate1 derive(fecha_registro = toDate(fecha_registro)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          ciudad as string,",
				"          segmento as string,",
				"          fecha_registro as date,",
				"          edad as integer,",
				"          nivel_fidelidad as string,",
				"          email as string,",
				"          telefono as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          cliente_id,",
				"          nombre,",
				"          ciudad,",
				"          segmento,",
				"          fecha_registro,",
				"          email,",
				"          telefono",
				"     )) ~> sink1"
			]
		}
	}
}