{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_alta = iif(isNull(fecha_alta) || toString(fecha_alta) == 'NULL' || trim(toString(fecha_alta)) == '', toDate(null()), toDate(fecha_alta, 'yyyy-MM-dd')),",
				"          nombre_repartidor = initCap(lower(trim(nombre_repartidor))),",
				"          ciudad_base = case(\r",
				"    isNull(ciudad_base) || upper(trim(toString(ciudad_base))) == 'NULL' || trim(toString(ciudad_base)) == '', toString(null()),\r",
				"    upper(trim(toString(ciudad_base))) == 'SCZ', 'Santa Cruz de la Sierra',\r",
				"    upper(trim(toString(ciudad_base))) == 'CBA', 'Cochabamba',\r",
				"    upper(trim(toString(ciudad_base))) == 'LPZ', 'La Paz',\r",
				"    initCap(lower(trim(toString(ciudad_base))))\r",
				")\r",
				",",
				"          activo = iif(toString(activo) == 'No', 'No', 'Sí')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}